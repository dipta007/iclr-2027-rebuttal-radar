<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs refresh.sh at 07:10 and 19:10 local time, which is 12:10 and 00:10 UTC in EST. Shifts by one hour under daylight saving. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dipta007.rebuttal-radar</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Volumes/my-world-8tb/iclr/scores/refresh.sh</string></array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>10</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>10</integer></dict>
  </array>
  <key>StandardErrorPath</key><string>/tmp/rebuttal-radar.launchd.log</string>
</dict>
</plist>
